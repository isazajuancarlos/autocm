[Unit]
Description=AutoCM — Facebook cada dos días (solo lo aprobado)

[Timer]
# Facebook es página de MARCA y canal SENSIBLE: cada dos días, no a diario. Su
# algoritmo diluye el alcance de una página nueva que publica de más con poco
# engagement, y `reclamar()` solo le entrega lo APROBADO —la línea de FB se cura
# a mano—. Días alternos, cuatro por semana.
OnCalendar=Mon,Wed,Fri,Sun 12:30:00 America/Bogota
# Hora exacta todos los días = huella de robot; y esta hora (12:30) es distinta
# de las de bluesky (10:20), devto (13:15) y mastodon (17:40) para no publicar
# lo mismo en el mismo minuto en varios canales, que es lo que delata el bot.
RandomizedDelaySec=1800
# Sin linger, el temporizador corre solo con la sesión de Juan abierta; esto
# recupera la corrida perdida en vez de saltársela en silencio.
Persistent=true
Unit=autocm-cola@facebook.service

[Install]
WantedBy=timers.target
