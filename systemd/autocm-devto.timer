[Unit]
Description=AutoCM — un artículo diario en dev.to

[Timer]
# Entre las dos horas de la cola (bluesky 10:20, mastodon 17:40) para no
# amontonar toda la presencia del día en el mismo rato.
OnCalendar=*-*-* 13:15:00 America/Bogota
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
