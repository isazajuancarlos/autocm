[Unit]
Description=AutoCM — LinkedIn 3x/semana (solo lo aprobado, autor person)

[Timer]
# LinkedIn es canal SENSIBLE: `reclamar()` solo le entrega lo APROBADO —publica
# bajo el perfil personal de Juan (modo person), así que la línea se cura a mano—.
# Tres por semana (Mar/Jue/Sab), la cadencia que LinkedIn tolera sin parecer bot.
OnCalendar=Tue,Thu,Sat 08:45:00 America/Bogota
# Hora 08:45 distinta de bluesky (10:20), facebook (12:30), devto (13:15) y
# mastodon (17:40) para no publicar lo mismo en el mismo minuto en varios canales.
RandomizedDelaySec=1800
# Sin linger, el temporizador corre solo con la sesión abierta; esto recupera la
# corrida perdida en vez de saltársela en silencio.
Persistent=true
Unit=autocm-cola@linkedin.service

[Install]
WantedBy=timers.target
