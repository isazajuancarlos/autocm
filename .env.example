# ============================================
# XILIUX AUTOCM - CONFIGURACIÓN
# ============================================
# Copia este archivo como .env y completa con tus credenciales

# === GENERAL ===
TARGET_URL=https://www.xiliux.com
BASE_URL=https://www.xiliux.com

# === OPENAI (Para generación de copy) ===
OPENAI_API_KEY=tu_api_key_aqui

# === MASTODON ===
MASTODON_ACCESS_TOKEN=tu_token_aqui
MASTODON_API_URL=https://mastodon.social
MASTODON_ENABLED=true  # Cambiar a "false" para desactivar

# === TWITTER/X ===
TWITTER_API_KEY=tu_api_key
TWITTER_API_SECRET=tu_api_secret
TWITTER_ACCESS_TOKEN=tu_access_token
TWITTER_ACCESS_SECRET=tu_access_secret

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=tu_bot_token
TELEGRAM_CHAT_ID=tu_chat_id

# === BLUESKY ===
BLUESKY_HANDLE=tu.handle.bsky.social
BLUESKY_PASSWORD=tu_password

# === DISCORD ===
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/tu_webhook_url

# === LINKEDIN (Opcional) ===
# Modo de autor: "person" publica como el perfil de Juan Carlos Isaza
# (w_member_social, disponible ya); "organization" como la página Xillux
# (Community Management API, requiere aprobación de LinkedIn — hoy denegada).
LINKEDIN_AUTHOR_MODE=person
LINKEDIN_ACCESS_TOKEN=tu_token
LINKEDIN_PERSON_SUB=tu_sub_openid   # solo modo person; lo imprime get_linkedin_token.py
LINKEDIN_ORG_ID=tu_org_id           # solo modo organization

# === REDDIT ===
# Cómo obtener credenciales: Ver REDDIT_SETUP.md
REDDIT_CLIENT_ID=tu_client_id_14_chars
REDDIT_CLIENT_SECRET=tu_client_secret_27_chars
REDDIT_USERNAME=tu_usuario_reddit
REDDIT_PASSWORD=tu_contraseña_reddit
REDDIT_SUBREDDIT=test  # Sin el "r/", ej: "python" para r/python
REDDIT_ENABLED=false   # Cambiar a "true" solo cuando estés listo (lee las reglas primero!)

# === FACEBOOK ===
# Cómo obtener el Page Access Token:
# 1. Ir a https://developers.facebook.com/tools/explorer/
# 2. Seleccionar tu App y generar token con permisos: pages_manage_posts, pages_read_engagement
# 3. Cambiar de "User Token" a tu página específica
# 4. Copiar el Page Access Token generado
FACEBOOK_PAGE_ACCESS_TOKEN=tu_page_access_token
FACEBOOK_PAGE_ID=tu_page_id

# ============================================
# EMAIL MARKETING
# ============================================

# === SMTP Configuration ===
# Opción 1: Gmail (Para testing)
# 1. Activar verificación en 2 pasos en tu cuenta Google
# 2. Ir a: https://myaccount.google.com/apppasswords
# 3. Crear contraseña para "Correo"
# 4. Usar esa contraseña de 16 caracteres aquí
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu_contraseña_de_app_aqui

# Opción 2: SendGrid (Recomendado para producción)
# SMTP_SERVER=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=tu_sendgrid_api_key

# Opción 3: Mailgun
# SMTP_SERVER=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@tu-dominio.mailgun.org
# SMTP_PASSWORD=tu_mailgun_password

# === Email Settings ===
FROM_EMAIL=noreply@xiliux.com
FROM_NAME=Xiliux
PREVIEW_EMAIL=tu-email-de-pruebas@gmail.com

# === API de Captura de Leads ===
API_PORT=5000
BULK_IMPORT_KEY=cambia_esta_clave_secreta_por_algo_aleatorio

# ============================================
# NOTAS DE CONFIGURACIÓN
# ============================================
#
# 1. NUNCA compartas tu archivo .env real
# 2. Añade .env a .gitignore
# 3. Para Gmail, usa contraseña de aplicación, NO tu contraseña normal
# 4. SendGrid ofrece 100 emails/día gratis
# 5. La API de leads corre en puerto 5000 por defecto
#

# --- Interruptores de canal (AutoCM es el altavoz de XILIUX, no de Juan Carlos) ---
# Sin interruptor en "true", el canal NO publica aunque tenga credenciales válidas.
MASTODON_ENABLED=true
TELEGRAM_ENABLED=true
DISCORD_ENABLED=true
LINKEDIN_ENABLED=true     # autor según LINKEDIN_AUTHOR_MODE (person = perfil dual JC Isaza; organization = página Xillux)
EMAIL_ENABLED=true

# Apagados a propósito — leer antes de encender:
TWITTER_ENABLED=false     # X: por UI (publicar_ui.py, red "x") con la cuenta de MARCA Xiliux, NO la personal @isazajuancarlos. El login va por `--importar-sesion x` (X bloquea el login automatizado). Enciende solo tras trasplantar la sesión
BLUESKY_ENABLED=false     # idem
FACEBOOK_ENABLED=false    # público equivocado para herramientas de desarrollo
REDDIT_ENABLED=false      # la autopromoción automatizada acaba en baneo: publica a mano
NOSTR_ENABLED=false       # enciende cuando pongas NOSTR_NSEC y NOSTR_RELAYS abajo

# === NOSTR (nota kind-1 firmada, difundida a relays; canal PROPIO, sin baneo) ===
# La clave privada en bech32 (nsec1…) o hex de 64. ES SECRETO: acceso total a la
# identidad Nostr. NUNCA se versiona.
NOSTR_NSEC=nsec1tu_clave_privada
# Relays wss:// separados por coma (ej. los grandes públicos):
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net,wss://relay.snort.social

# === DEV.TO (republicación del blog con canonical_url) ===
# dev.to -> Settings -> Extensions -> DEV Community API Keys -> Generate API Key
DEV_TO_API_KEY=tu_api_key

# === CANVA (imágenes de post por la Connect API) ===
# La Autofill API EXIGE una organización Canva Enterprise (trial en planes de
# pago durante el desarrollo). Ver docs/CANVA.md.
CANVA_CLIENT_ID=tu_client_id
CANVA_CLIENT_SECRET=tu_client_secret     # credencial: 600, no se versiona
CANVA_ACCESS_TOKEN=                        # lo imprime canva_oauth.py
CANVA_REFRESH_TOKEN=                       # idem; para renovar sin navegador
CANVA_BRAND_TEMPLATE_ID=                    # el ID de tu Brand Template
CANVA_CAMPO_TITULO=titulo                   # clave del campo de texto del título
CANVA_CAMPO_CUERPO=                         # clave del campo del cuerpo (opcional)
CANVA_OAUTH_PORT=8766

# === IMAGEN DE POST (vía híbrida: fondo de Canva + texto con Pillow) ===
IMAGEN_BACKEND=tarjeta                  # 'tarjeta' (híbrida) | 'canva' (Enterprise)
TARJETA_FONDO=fondos                    # archivo, o CARPETA (rota al azar entre sus fondos)
TARJETA_CAJA=170,210,1340,510           # hueco de texto del fondo de marca (px)
TARJETA_FUENTE=                         # .ttf; por defecto DejaVu Sans Bold
TARJETA_COLOR=#FFFFFF
TARJETA_ALINEAR=center
TARJETA_SOMBRA=1
IMAGEN_DIR=                             # dónde persisten las tarjetas generadas (por defecto ./tarjetas)
